# Cloudinary 이미지/동영상 미디어 서버 설정
VITE_CLOUDINARY_CLOUD_NAME=ducor31pp
VITE_CLOUDINARY_UPLOAD_PRESET=mangotour

# Supabase 회원 인증 및 데이터베이스 설정 (신규)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini API
GEMINI_API_KEY=

# 관리자 로그인 비밀번호 (소스 코드/SQL 평문 노출 방지 - 배포 환경변수에 직접 설정)
VITE_ADMIN_PASSWORD=

# 견적서 PDF 관리자 이메일 자동 첨부 발송 설정 (Gmail SMTP 전용, 서버 전용 - VITE_ 접두사 금지)
ADMIN_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Supabase Storage PDF 업로드용 서비스 롤 키 및 버킷명 (서버 전용)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_QUOTATION_BUCKET=quotations

# 로컬 서버 저장 폴백 시 절대 URL 기준 도메인 (선택)
PUBLIC_BASE_URL=

